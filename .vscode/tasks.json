{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flash",
      "type": "process",
      "command": "openocd",
      "args": [
        "-f",
        "interface/stlink.cfg",
        "-f",
        "target/stm32f0x.cfg",
        "-c",
        "program \"${command:cmake.launchTargetPath}\" verify reset exit"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "openocd"
      }
    },
    {
      "label": "Flash (Cube)",
      "type": "process",
      "command": "C:/ST/STM32CubeCLT_1.18.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
      "args": [
        "-c",
        "port=SWD",
        "-d",
        "${command:cmake.launchTargetPath}",
        "-rst"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "C:/ST/STM32CubeCLT_1.18.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe"
      }
    }
  ]
